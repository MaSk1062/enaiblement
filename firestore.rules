rules_version = '2';

// Deny every client. This is not a placeholder - it is the correct rule for this app.
//
// The browser bundle imports `firebase/app` and `firebase/auth` and nothing else: it holds an
// ID token and sends it to our own API. Every Firestore read and write happens server-side in
// `app/services/firestore.ts` through the Admin SDK under Application Default Credentials,
// which bypasses these rules entirely. So there is no legitimate direct-from-browser access to
// allow, and allowing any would be a second, unauthenticated door into user sessions.
//
// If a future feature genuinely needs the client to read Firestore directly, scope it to the
// owner rather than reopening the database:
//
//   match /sessions/{id} {
//     allow read: if request.auth != null && resource.data.userId == request.auth.uid;
//   }

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
