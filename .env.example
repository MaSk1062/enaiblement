# docs/ARCHITECTURE.md Appendix B. Copy to .env; never commit the real one.
# Verify the model ids with: node scripts/verify-kickoff.mjs

# Auth is Application Default Credentials — there is no API key and no Secret Manager entry.
#   locally:   gcloud auth application-default login
#   Cloud Run: the runtime service account, via the metadata server, automatically
# The runtime SA needs roles/aiplatform.user and roles/datastore.user.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
FIRESTORE_DATABASE_ID=(default)   # a non-default database id fails as "5 NOT_FOUND"

GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768   # must match the vector index; pinned via outputDimensionality
RAG_TOP_K=3
MAX_TURNS_PER_MINUTE=20

# Firebase client SDK (public by design — these ship to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# The project that MINTS the ID tokens. Only set this when Firebase Auth lives in a
# different project from Firestore — verifyIdToken checks the token's audience against it,
# and a mismatch fails every sign-in as "Invalid or expired token". Defaults to
# GCP_PROJECT_ID; normally the same as VITE_FIREBASE_PROJECT_ID.
FIREBASE_AUTH_PROJECT_ID=

# Deploy targets (scripts/setup-gcp.sh, scripts/deploy.sh). Defaults shown.
DEPLOY_REGION=us-central1
DEPLOY_SERVICE=enaible
DEPLOY_REPO=enaible
DEPLOY_TIMEOUT=300        # Cloud Run request timeout, seconds; max 3600

# The Architect looks its model menu up with a grounded web search, cached for the life of the
# process. Set this to pin the list instead — an explicit menu always wins over the search, and
# scripts/eval.ts uses that to test whether the prompt actually obeys the menu it is given.
# ARCHITECT_MODEL_MENU=

# scripts/monitoring.sh creates the alert policy only when this is set. Without it you still
# get the log-based metrics and the dashboard.
# ALERT_EMAIL=
